datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model UserPoints {
  id        String @id @default(cuid())
  userId    String @unique
  points    Int    @default(0)
  lastDailyClaim   DateTime?
  lastStealAttempt DateTime?
  updatedAt DateTime @updatedAt
}